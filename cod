<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador Mega-Sena Pro</title>
    <style>
        :root { --cor-caixa: #209824; --cor-primaria: #004a8d; --cor-ouro: #ffc107; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f0f2f5; display: flex; justify-content: center; padding: 20px; }
        .app-container { background: white; width: 100%; max-width: 500px; padding: 25px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); text-align: center; }
        
        h1 { color: var(--cor-primaria); margin-bottom: 5px; }
        .setup-section { background: #e8f5e9; padding: 15px; border-radius: 12px; margin-bottom: 20px; }
        
        .input-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 20px 0; }
        input { width: 45px; height: 45px; text-align: center; border: 2px solid #ddd; border-radius: 8px; font-size: 18px; font-weight: bold; }
        input:focus { border-color: var(--cor-caixa); outline: none; }

        .btn-sortear { width: 100%; padding: 15px; background: var(--cor-primaria); color: white; border: none; border-radius: 10px; font-size: 18px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        .btn-sortear:hover { background: #003566; }

        .info-painel { text-align: left; background: #f8f9fa; border-left: 5px solid var(--cor-primaria); padding: 15px; margin: 20px 0; font-size: 14px; }
        
        .resultado-area { margin-top: 25px; padding-top: 20px; border-top: 2px dashed #ddd; }
        .bola { display: inline-block; width: 45px; height: 45px; line-height: 45px; margin: 5px; background: var(--cor-caixa); color: white; border-radius: 50%; font-weight: bold; font-size: 18px; animation: pop 0.3s ease-out; }
        .acerto { background: var(--cor-ouro) !important; color: #333 !important; box-shadow: 0 0 15px var(--cor-ouro); transform: scale(1.1); }
        
        @keyframes pop { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        .mensagem-final { margin-top: 15px; font-size: 20px; font-weight: bold; color: var(--cor-primaria); }
    </style>
</head>
<body>

<div class="app-container">
    <h1>Mega Simulator</h1>
    <p>Simulador Matemático e Financeiro</p>

    <div class="setup-section">
        <label>Quantos números deseja marcar? </label>
        <select id="qtdSelect" onchange="configurarJogo()">
            <option value="6">6 (Mínimo)</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
            <option value="15">15 (Máximo)</option>
        </select>
    </div>

    <div class="info-painel" id="painelMatematico">
        </div>

    <div class="input-grid" id="gridInputs">
        </div>

    <button class="btn-sortear" onclick="processarSorteio()">SORTEAR E CONFERIR</button>

    <div class="resultado-area" id="secaoResultado" style="display:none;">
        <h3>Números Sorteados:</h3>
        <div id="bolasSorteio"></div>
        <div class="mensagem-final" id="statusMensagem"></div>
    </div>
</div>

<script>
    const PRECO_UNITARIO = 5.00;
    const TOTAL_COMBINACOES_MEGA = 50063860;

    // Função Matemática de Fatorial
    function fatorial(n) {
        if (n === 0 || n === 1) return 1;
        let res = 1;
        for (let i = n; i > 1; i--) res *= i;
        return res;
    }

    // Cálculo de Combinação Simples C(n, k)
    function calcularCombinacoes(n, k) {
        return Math.round(fatorial(n) / (fatorial(k) * fatorial(n - k)));
    }

    function configurarJogo() {
        const n = parseInt(document.getElementById('qtdSelect').value);
        const grid = document.getElementById('gridInputs');
        const painel = document.getElementById('painelMatematico');
        
        // 1. Gerar Inputs
        grid.innerHTML = '';
        for (let i = 0; i < n; i++) {
            grid.innerHTML += `<input type="number" class="num-user" min="1" max="60" placeholder="${i+1}">`;
        }

        // 2. Cálculos de Análise Combinatória
        const jogosSimples = calcularCombinacoes(n, 6);
        const custo = jogosSimples * PRECO_UNITARIO;
        const prob = Math.round(TOTAL_COMBINACOES_MEGA / jogosSimples);

        painel.innerHTML = `
            <strong>Matemática da Aposta:</strong><br>
            • Fórmula: C(${n}, 6) = ${n}! / (6! * (${n}-6)!)<br>
            • Total de jogos simples: <b>${jogosSimples}</b><br>
            • Custo total: <b style="color:green">${custo.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'})}</b><br>
            • Chance de Sena: 1 em <b>${prob.toLocaleString('pt-BR')}</b>
        `;
        
        document.getElementById('secaoResultado').style.display = 'none';
    }

    function processarSorteio() {
        // Coletar números do usuário
        const inputs = document.querySelectorAll('.num-user');
        let palpite = [];
        inputs.forEach(i => {
            let val = parseInt(i.value);
            if (!isNaN(val) && val >= 1 && val <= 60) palpite.push(val);
        });

        if (palpite.length < inputs.length) {
            alert("Preencha todos os números corretamente!");
            return;
        }

        // Sorteio da Máquina
        let sorteio = [];
        while(sorteio.length < 6) {
            let n = Math.floor(Math.random() * 60) + 1;
            if(!sorteio.includes(n)) sorteio.push(n);
        }
        sorteio.sort((a,b) => a-b);

        // Conferência
        let acertos = 0;
        const bolasDiv = document.getElementById('bolasSorteio');
        bolasDiv.innerHTML = '';
        
        sorteio.forEach(num => {
            const ehAcerto = palpite.includes(num);
            if(ehAcerto) acertos++;
            bolasDiv.innerHTML += `<div class="bola ${ehAcerto ? 'acerto' : ''}">${num}</div>`;
        });

        // Mensagem
        const msg = document.getElementById('statusMensagem');
        document.getElementById('secaoResultado').style.display = 'block';
        
        if(acertos === 6) msg.innerHTML = "🏆 SENA! Você ficou rico!";
        else if(acertos === 5) msg.innerHTML = "🥈 QUINA! Um belo prêmio!";
        else if(acertos === 4) msg.innerHTML = "🥉 QUADRA! Ganhou um trocado.";
        else msg.innerHTML = `Acertou ${acertos} números.`;
    }

    // Inicialização
    configurarJogo();
</script>

</body>
</html>
